{"tier": "glm-5.2", "verse": 32, "ref": "1-kings 12:32", "book": "1-kings", "lang": "ur", "chapter": 12, "translation": "اور یَرووام نے آٹھویں مہینے میں، مہینے کے پندرہویں دن، تہوار بنایا، اُس تہوار کی طرح جو یہوداہ میں ہے، اور وہ قربان گاہ پر چڑھا۔ بیت ایل میں اُس نے اُن بچھڑوں کو ذبح کرنے کے لیے جو اُس نے بنائے تھے، اُسی طرح کیا۔ اور بیت ایل میں باموں کے ⟨את⟩ کاہنوں کو جنہیں اس نے بنایا تھا، کھڑا کیا۔", "tokens": [{"surface": "ויעש", "gloss": "اور بنایا"}, {"surface": "ירבעם", "gloss": "یَرووام"}, {"surface": "חג", "gloss": "تہوار"}, {"surface": "בחדש", "gloss": "مہینے میں"}, {"surface": "השמיני", "gloss": "آٹھویں"}, {"surface": "בחמשה", "gloss": "پندرہویں"}, {"surface": "עשר", "gloss": "دن"}, {"surface": "יום", "gloss": "کے"}, {"surface": "לחדש", "gloss": "مہینے"}, {"surface": "כחג", "gloss": "تہوار کی طرح"}, {"surface": "אשר", "gloss": "جو"}, {"surface": "ביהודה", "gloss": "یہوداہ میں"}, {"surface": "ויעל", "gloss": "اور چڑھا"}, {"surface": "על", "gloss": "پر"}, {"surface": "המזבח", "gloss": "قربان گاہ"}, {"surface": "כן", "gloss": "اسی طرح"}, {"surface": "עשה", "gloss": "کیا"}, {"surface": "בבית", "gloss": "بیت میں"}, {"surface": "אל", "gloss": "ایل"}, {"surface": "לזבח", "gloss": "ذبح کرنے کے لیے"}, {"surface": "לעגלים", "gloss": "بچھڑوں کو"}, {"surface": "אשר", "gloss": "جنہیں"}, {"surface": "עשה", "gloss": "بنایا"}, {"surface": "והעמיד", "gloss": "اور کھڑا کیا"}, {"surface": "בבית", "gloss": "بیت میں"}, {"surface": "אל", "gloss": "ایل"}, {"surface": "את", "gloss": "⟨את⟩", "marks": "باموں کے کاہنوں کو"}, {"surface": "כהני", "gloss": "کاہنوں کو"}, {"surface": "הבמות", "gloss": "باموں کے"}, {"surface": "אשר", "gloss": "جنہیں"}, {"surface": "עשה", "gloss": "بنایا"}], "timestamp": "2026-08-09T21:46:24.170258190Z", "model": "glm-5.2"}